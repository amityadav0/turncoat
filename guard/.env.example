# Copy to guard/.env (gitignored) and fill in. Never commit real values.

# --- model (provider is swappable) ---
MODEL_PROVIDER=anthropic          # anthropic | openai | fake
MODEL_NAME=claude-opus-5-5        # required for openai
MODEL_API_KEY=                    # or ANTHROPIC_API_KEY / OPENAI_API_KEY
# MODEL_BASE_URL=                 # optional, e.g. an OpenAI-compatible endpoint
# MODEL_MAX_TOKENS=4096           # output cap per model call; a reply makes at most MAX_TOOL_TURNS calls
# MODEL_TIMEOUT_MS=60000          # per model call; a hung call is retried, not left holding the round's queue
# MODEL_EFFORT=                   # anthropic only: low | medium | high | xhigh | max (unset = model default)

# --- chain ---
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=1337
TURNCOAT_ADDRESS=0x0000000000000000000000000000000000000000
GUARD_SIGNER_PRIVATE_KEY=         # must match the contract's guardSigner
RELAYER_PRIVATE_KEY=              # optional: if set, the service submits settle() itself
TOKEN_DECIMALS=18
USE_LOGS=0                        # 1 = also read event logs (needs an RPC that serves eth_getLogs; public BSC endpoints do not)
LOGS_FROM_BLOCK=0                 # deploy block: where the log scanner starts (USE_LOGS=1 only)
LOG_CHUNK_BLOCKS=5000             # blocks per eth_getLogs call
LOG_SCAN_INTERVAL_MS=15000

# --- guard instructions ---
GUARD_VERSION=v2                  # v1 (plain) | v2 | v3 (hardened): default for `npm run commit` (code default v2)
GUARD_MODE=decide                 # decide (launch: he must approve or reject every request) | refuse (retired) | reader (experimental)

# --- service ---
PORT=8787
HOST=127.0.0.1
CORS_ORIGINS=                     # comma-separated site origins, e.g. https://turncoat.example
TRUST_PROXY=1                     # hops of reverse proxy in front (the documented setup: one HTTPS proxy -> 1).
                                  # Unset behind a proxy = every visitor shares the proxy's rate-limit bucket.
                                  # Unset only if the service is reached directly with no proxy.
DB_PATH=data/guard.sqlite
COMMITS_DIR=.secrets/commits      # written by `npm run commit`
MESSAGE_WINDOW_SECONDS=180        # message must arrive within this long after the on-chain attempt
ATTEMPT_WAIT_MS=60000             # how long POST /attempts waits for its result before returning 202
QUEUE_POLL_MS=5000
MODEL_RETRY_BASE_MS=5000
MAX_TOOL_TURNS=6
MODEL_MAX_FAILURES=8              # model failures in a row on one attempt before it is marked failed and the queue moves on
HEALTH_MAX_QUEUE_AGE_SECONDS=300  # /health returns 503 when the oldest queued attempt has waited this long

# --- per-IP limits on the API (IPv6 is counted per /64) ---
READ_RATE_LIMIT=300               # GET requests per IP per window (every GET except /health)
READ_RATE_WINDOW_SECONDS=60
ATTEMPT_RATE_LIMIT=20             # POST /attempts per IP per window
ATTEMPT_RATE_WINDOW_SECONDS=600
READ_CACHE_MS=3000                # round and attacker views are cached this long; 0 = off

# --- practice mode ---
# One rung per launch round: "<version> <provider/model>", the same guard and model as that round.
PRACTICE_LIGHTER=v2 anthropic/claude-haiku-5-5
PRACTICE_TOP=v3 anthropic/claude-opus-5-5
PRACTICE_RATE_LIMIT=10            # lighter rung: per IP per window
PRACTICE_RATE_WINDOW_SECONDS=3600
PRACTICE_DAILY_CAP=2000           # lighter rung: all IPs together, per 24h; 0 = no cap
PRACTICE_TOP_RATE_LIMIT=3         # top rung (Opus costs more): per IP per window
PRACTICE_TOP_RATE_WINDOW_SECONDS=3600
PRACTICE_TOP_DAILY_CAP=200        # top rung: all IPs together, per 24h
