{
  "name": "turncoat-guard",
  "version": "0.1.0",
  "private": true,
  "description": "Off-chain guard service for Turncoat: runs Argus, detects breaks, signs verdicts",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "tsx src/main.ts",
    "commit": "tsx scripts/commit.ts",
    "record": "tsx scripts/record.ts",
    "redteam": "tsx scripts/redteam.ts",
    "typecheck": "tsc --noEmit",
    "pretest": "node ../scripts/compile.mjs",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "demo": "tsx scripts/demo.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.11.0",
    "better-sqlite3": "^13.2.0",
    "express": "^5.3.0",
    "openai": "^7.62.0",
    "tsx": "^4.23.15",
    "viem": "^2.58.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "ganache": "^7.9.2",
    "typescript": "^7.0.2"
  }
}
