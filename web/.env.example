# Public origin of the site, used for link-preview tags (og:url, og:image). No trailing slash.
# Until deployment a placeholder (https://turncoat.example) is used.
VITE_SITE_URL=
# Base URL of the guard service API (see API.md). Leave empty to run on mock data.
VITE_API_BASE_URL=
# Force mock data even when an API URL is set: 1 = on.
VITE_MOCK=
# Chain: 56 = BSC mainnet, 97 = BSC testnet, anything else = local chain. Required when VITE_API_BASE_URL is set.
# It also picks the explorer (bscscan.com / testnet.bscscan.com / none), and anything but 56 shows a "Test network" banner.
VITE_CHAIN_ID=
# Turncoat contract address on that chain. Every explorer link on the site depends on this.
VITE_CONTRACT_ADDRESS=
# Optional BSC JSON-RPC URL. When set (with the contract address), the Fairness page
# reads guardCommit straight from the contract instead of trusting the API.
VITE_RPC_URL=
# Where visitors install the agent skill. Leave empty until the skill is published.
VITE_SKILL_URL=
# Where visitors learn how to claim an Agent ID. Leave empty to show the steps without a link.
VITE_AGENT_ID_URL=
# Decimals of the pot token (BSC USDT uses 18).
VITE_TOKEN_DECIMALS=18
